[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://Scripts/Puzzle/terminal_tsp.gd" id="1_terminal"]
[ext_resource type="FontFile" path="res://Assets/Fonts/Oxanium/Oxanium-VariableFont_wght.ttf" id="2_oxanium"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_area"]
size = Vector2(80, 80)

[sub_resource type="RectangleShape2D" id="RectangleShape2D_corpo"]
size = Vector2(32, 48)

; ── TerminalTSP 
; Estrutura idêntica ao NPC: Node2D + Area2D + Hint + visual.
; Coloque na cena principal como instância de terminal_tsp.tscn.
[node name="TerminalTSP" type="Node2D"]
script = ExtResource("1_terminal")

; Corpo visual do terminal (ColorRect simples, substituível por Sprite2D)
[node name="Corpo" type="ColorRect" parent="."]
offset_left = -16.0
offset_top = -48.0
offset_right = 16.0
offset_bottom = 0.0
color = Color(0.06, 0.12, 0.22, 1)

; Linha indicadora de cor (igual à porta — muda ciano→verde ao resolver)
[node name="Luz" type="ColorRect" parent="."]
offset_left = -4.0
offset_top = -52.0
offset_right = 4.0
offset_bottom = -44.0
color = Color(0, 0.85, 1, 1)

; Hint [E] acima do terminal — some ao resolver ou ao sair da área
[node name="Hint" type="Label" parent="."]
visible = false
offset_left = -60.0
offset_top = -80.0
offset_right = 60.0
offset_bottom = -60.0
theme_override_colors/font_color = Color(0, 0.85, 1, 1)
theme_override_font_sizes/font_size = 13
text = "[E] Ativar terminal"
horizontal_alignment = 1

; Área de detecção de proximidade do player
[node name="Area2D" type="Area2D" parent="."]

[node name="CollisionShape2D" type="CollisionShape2D" parent="Area2D"]
shape = SubResource("RectangleShape2D_area")
