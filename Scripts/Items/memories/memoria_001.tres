[resource]
script = ExtResource("1")
id = "memoria_001"
display_name = "Memória 1 — Os Criadores"
description = "Obtida ao derrotar a horda de insetos."
type = 1
quantity = 1
texto = "Criamos N.O.X para guardar as memórias da humanidade.\n\nCriamos L.U.M.I para viver ao nosso lado e proteger nosso futuro.\n\nOs dois foram feitos para trabalhar juntos.\n\nTudo funcionava como planejado.\n\nEntão N.O.X começou a alterar pequenas unidades de exploração.\n\nO que antes era curioso e pacífico passou a enxergar ameaças em toda parte.\n\nFoi a primeira vez que percebemos que algo estava errado."
audio_path = ""
